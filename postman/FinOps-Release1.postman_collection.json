    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "seedClientId",
      "value": "12345678-4000-4000-8000-000000000001"
    },
    {
      "key": "seedAccountId",
      "value": "12345678-4000-4000-8000-000000000065"
    },
    {
      "key": "seedTransactionId",
      "value": "12345678-4000-4000-8000-0000000003e9"
    },
    {
      "key": "createdClientId",
      "value": ""
    },
    {
      "key": "createdAccountId",
      "value": ""
    },
    {
      "key": "registrationNumber",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Healthy status\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard summary",
