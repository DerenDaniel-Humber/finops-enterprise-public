    {
      "name": "Register corporate client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/clients",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"companyName\": \"Postman Test Corporation\",\n  \"registrationNumber\": \"{{registrationNumber}}\",\n  \"industry\": \"Technology\",\n  \"country\": \"Canada\",\n  \"contactEmail\": \"ops@postman.example\",\n  \"contactPhone\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"registrationNumber\", \"PM-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const c=pm.response.json().data; pm.collectionVariables.set(\"createdClientId\",c.clientId);",
              "pm.test(\"New client is active\",()=>pm.expect(c.status).to.eql(\"Active\"));"
            ]
          }
        }
      ]
    },
