{
  "info": {
    "name": "FinOps Enterprise \u2014 Release 1",
    "description": "Run sequentially against a disposable COPY of demonstration data. The runner creates a client and account; Release 1 has no deletion endpoints. Do not run repeatedly against a dataset you need to keep pristine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
